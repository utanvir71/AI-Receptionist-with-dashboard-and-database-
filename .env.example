# Copy to .env for Docker Compose. Keep real .env files out of git.

APP_ENV=production
APP_TIMEZONE=Asia/Seoul
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_PORT=8080

# Local/demo value only. Replace before deploying.
MSSQL_DB=ai_receptionist
MSSQL_SA_PASSWORD=Change_this_local_sa_password_123!
DATABASE_URL=mssql+pyodbc://sa:Change_this_local_sa_password_123!@mssql:1433/ai_receptionist?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Demo password for this sample hash: change-me-staff-password
# Generate a real hash with:
# cd backend && python -c "from app.core.staff_auth import hash_staff_password; print(hash_staff_password('your-password'))"
STAFF_PASSWORD_HASH='pbkdf2_sha256$260000$demo-dashboard-salt$cf5a6097138a353afa2a04fdfe1d4fddee1a7285b7cfbf5b8fcbefc1ed494237'
SESSION_SECRET_KEY=change-this-local-session-secret
DEMO_MODE=true

VAPI_TOOL_SECRET=local-vapi-secret
VAPI_MANAGER_TRANSFER_NUMBER=

# Leave blank for local tests unless intentionally sending SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional ngrok profile.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

LOG_LEVEL=INFO
